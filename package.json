{
  "name": "codex-agentic-utils",
  "version": "0.1.0",
  "description": "Codex-native ADR and architecture-design skills with reusable specialist agents",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "codex-agentic-utils": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist coverage",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "codex",
    "adr",
    "architecture",
    "hld",
    "agents",
    "skills"
  ],
  "author": "Codex Agentic Utils contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbaghilovici/codex-agentic-utils.git"
  },
  "bugs": {
    "url": "https://github.com/danbaghilovici/codex-agentic-utils/issues"
  },
  "homepage": "https://github.com/danbaghilovici/codex-agentic-utils#readme",
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
